---
import { pageLocale, t } from '../../i18n/ui';
import UiStrings from '../../components/UiStrings.astro';
import SceneIsland from '../SceneIsland.astro';
import { Demo2D, Demo3D, DemoCosines, DemoPolar, DemoSign, DemoLamp, DemoTiles, DemoDotFormula, DemoLedger, DemoChallenges, DemoVecReadout } from './engine';
import { ROWS2, ROWS3, ROWSLC, ROWSPOLAR, ROWSSIGN, ROWSLAMP } from './engine.rows';
const components = { Demo2D, Demo3D, DemoCosines, DemoPolar, DemoSign, DemoLamp, DemoTiles, DemoDotFormula, DemoLedger, DemoChallenges, DemoVecReadout };
interface Props { kind: keyof typeof components }
const locale = pageLocale(Astro);
const kind = Astro.props.kind;
const scenes = {
 Demo2D: { caption: t(locale, 'demo.captionDemo2D'), rows: ROWS2(locale) },
 DemoCosines: { caption: t(locale, 'demo.captionDemoCosines'), rows: ROWSLC(locale) },
 Demo3D: { caption: t(locale, 'demo.captionDemo3D'), rows: ROWS3(locale) },
 DemoPolar: { caption: t(locale, 'demo.captionDemoPolar'), rows: ROWSPOLAR(locale) },
 DemoSign: { caption: t(locale, 'demo.captionDemoSign'), rows: ROWSSIGN(locale) },
 DemoLamp: { caption: t(locale, 'demo.captionDemoLamp'), rows: ROWSLAMP(locale) },
};
---
<UiStrings ns={['viewport', 'gizmo', 'status', 'challenge', 'rows', 'demo']} />
{kind === 'Demo2D' && <SceneIsland {...scenes.Demo2D}><Demo2D locale={locale} client:only="react" /></SceneIsland>}
{kind === 'Demo3D' && <SceneIsland {...scenes.Demo3D}><Demo3D locale={locale} client:only="react" /></SceneIsland>}
{kind === 'DemoCosines' && <SceneIsland {...scenes.DemoCosines}><DemoCosines locale={locale} client:only="react" /></SceneIsland>}
{kind === 'DemoPolar' && <SceneIsland {...scenes.DemoPolar}><DemoPolar locale={locale} client:only="react" /></SceneIsland>}
{kind === 'DemoSign' && <SceneIsland {...scenes.DemoSign}><DemoSign locale={locale} client:only="react" /></SceneIsland>}
{kind === 'DemoLamp' && <SceneIsland {...scenes.DemoLamp}><DemoLamp locale={locale} client:only="react" /></SceneIsland>}
{kind === 'DemoTiles' && <SceneIsland caption={t(locale, 'demo.captionDemoTiles')}><DemoTiles locale={locale} client:only="react" /></SceneIsland>}
{kind === 'DemoDotFormula' && <DemoDotFormula locale={locale} client:load />}
{kind === 'DemoLedger' && <DemoLedger locale={locale} client:load />}
{kind === 'DemoChallenges' && <DemoChallenges locale={locale} client:load />}
{kind === 'DemoVecReadout' && <DemoVecReadout client:load />}
