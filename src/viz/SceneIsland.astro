---
/**
 * Server-rendered frame of a ViewportCard (src/viz/scene/ViewportCard.tsx) around a client:only scene island. The
 * caption is real HTML (the scene's accessible name, and the fallback without JS or WebGL). `.lab-vp-skel` paints the
 * card's skeleton (header, dark viewport, chip row on phones, status bar) and fixes its exact height before any
 * script runs: the 16:10 viewport comes from an aspect-ratio spacer and the bars are fixed px, so the island, which
 * fills the same box absolutely, causes no layout shift.
 * `rows`: the SAME N-panel rows array the card renders (declared in the lesson's SSR-safe entry module). The chip row
 * reserved under 720 px is computed from them by the fixed-width chip model (scene/chips.ts) at the 320 px basis, and
 * the card checks that its rows give the same line count. No `rows` (or an empty array) = a card without an N-panel.
 * `chipLines` overrides the computed line count (only for a deliberate exception; the card then skips its check).
 */
import { chipHeight, chipLines as linesOf, type ChipRow } from './scene/chips';

interface Props {
	caption: string;
	rows?: readonly ChipRow[];
	chipLines?: number;
	hud?: boolean;
	formula?: boolean;
	/** Authored mobile formula slot height; shared by SSR skeleton and live plate through one CSS variable. */
	formulaHeight?: number;
}
const { caption, rows = [], chipLines, hud = false, formula = false, formulaHeight = 76 } = Astro.props;
const panel = rows.length > 0;
const lines = panel ? (chipLines ?? linesOf(rows)) : 0;
if (!Number.isFinite(formulaHeight) || formulaHeight < 76) throw new Error('formulaHeight must be at least 76 CSS px');
const style = `--lab-vp-chip-h: ${chipHeight(lines)}px; --lab-vp-formula-h: ${formulaHeight}px`;
---

<figure
	class="lab-scene lab-vp not-content"
	data-hud={hud ? "" : undefined}
	data-formula={formula ? "" : undefined}
	data-panel={panel ? '' : undefined}
	data-chip-lines={panel ? lines : undefined}
	data-chip-override={chipLines !== undefined ? '' : undefined}
	style={style}
>
	<div class="lab-vp-frame">
		<div class="lab-vp-skel" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
		<slot />
	</div>
	<figcaption>{caption}</figcaption>
</figure>
