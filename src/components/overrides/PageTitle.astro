---
/**
 * Starlight PageTitle override: the stock <h1> plus, on lesson pages, a "Lesson N · Module M — Title"
 * eyebrow derived from course.json (frontmatter titles carry no numbers).
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { lessonByPath } from '../../lib/course';

const lesson = lessonByPath(Astro.locals.starlightRoute.id);
---

{
	lesson && (
		<p class="lesson-eyebrow">
			Lesson {lesson.num} · Module {lesson.moduleNum} — {lesson.moduleTitle}{lesson.optional && ' (optional)'}
		</p>
	)
}
<Default><slot /></Default>

<style>
	.lesson-eyebrow {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--sl-color-accent-high);
	}
	.lesson-eyebrow + :global(h1) {
		margin-top: 0.25rem;
	}
</style>
