---
/**
 * Starlight PageTitle override: the stock <h1> plus, on lesson pages, a "Lesson P.k · Part P — Title" eyebrow
 * derived from course.json (CURRICULUM.md numbering; frontmatter titles carry no numbers). Lessons of an
 * unnumbered module (`start`) show only the module title.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { lessonByPath, moduleOf, loc } from '../../lib/course';

import { pageLocale, t } from '../../i18n/ui';
const locale = pageLocale(Astro);
const lesson = lessonByPath(Astro.locals.starlightRoute.id);
// A lesson has an id exactly when its module has a part (`numberCourse`).
const nums = lesson?.id && `${t(locale, 'course.lesson', { num: lesson.id })} · ${t(locale, 'course.part', { num: String(lesson.part) })} — `;
---

{
	lesson && (
		<p class="lesson-eyebrow">
			{nums}{loc(moduleOf(lesson.slug), locale).title}{lesson.optional && t(locale, 'course.optional')}
		</p>
	)
}
<Default><slot /></Default>

<style>
	.lesson-eyebrow {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--sl-color-accent-high);
	}
	.lesson-eyebrow + :global(h1) {
		margin-top: 0.25rem;
	}
</style>
