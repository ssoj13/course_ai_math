---
import { modules, loc, href } from '../lib/course';
import { numbered } from '../lib/course-rules.mjs';
import { pageLocale, t } from '../i18n/ui';
const locale = pageLocale(Astro);
---
{modules.map(m => <section>
<h2>{numbered(m.part, loc(m, locale).title)}</h2>
<p>{loc(m, locale).summary}</p>
<ul>{m.lessons.map(l => <li>{l.id && `${l.id} `}<a href={href(l.slug, undefined, locale)}>{loc(l, locale).label}</a>{l.branch && t(locale, 'course.branch')} — {loc(l, locale).summary}</li>)}</ul>
</section>)}
